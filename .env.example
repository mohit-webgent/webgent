# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=https://webgent.vercel.app
NEXT_PUBLIC_APP_URL=https://webgent.vercel.app

# NextAuth Authentication Configuration
AUTH_SECRET="a_very_secret_32_character_long_auth_secret_key_webgent"
NEXTAUTH_SECRET="a_very_secret_32_character_long_auth_secret_key_webgent"
NEXTAUTH_URL="https://webgent.vercel.app"

# Database Configuration (PostgreSQL / Prisma / Supabase)
# For Vercel Serverless Production:
# 1. DATABASE_URL must point to Supabase Connection Pooler in TRANSACTION mode (port 6543) with ?pgbouncer=true&connection_limit=1
#    Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# 2. DIRECT_URL is used ONLY for Prisma migrations and CLI commands (direct port 5432)
#    Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webgent_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/webgent_db?schema=public"

# Admin Seed Initial Configuration (Never hardcode in source code; override in env)
SEED_ADMIN_EMAIL="admin@webgent.com"
SEED_ADMIN_PASSWORD="ChangeMeInProduction123!"

# Logger Configuration
LOG_LEVEL=info

# Email & Resend Configuration (Server-Side Only - Never expose to browser)
# Provide your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefg"
# Configurable sender email (e.g. "Webgent <hello@yourdomain.com>" or "Webgent <onboarding@resend.dev>")
EMAIL_FROM="Webgent <hello@webgent.com>"
# Recipient for inbound contact form notifications and system alerts
ADMIN_NOTIFICATION_EMAIL="admin@webgent.com"

# Cloudflare R2 Object Storage (Server-Side Only - Never expose to browser)
# Retrieve from Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="webgent-media"
R2_PUBLIC_URL="https://cdn.webgent.com"

# Notification Infrastructure (Phase 11: Real-Time Lead Notifications)
# Primary: WhatsApp via Twilio
# Configure your Twilio Account SID & Auth Token from https://console.twilio.com
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Twilio WhatsApp Sender (e.g. "+14155238886" for Twilio Sandbox, or your approved WhatsApp sender)
TWILIO_WHATSAPP_FROM="+14155238886"
# Destination WhatsApp phone number for lead alerts (E.164 format, e.g. "+15551234567")
ADMIN_WHATSAPP_TO="+15551234567"

# Alternative: WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"

# Optional: Slack Incoming Webhook
# Configure in Slack API > Incoming Webhooks
SLACK_WEBHOOK_URL="your_slack_incoming_webhook_url"

# AI Chat Concierge (Google Gemini API Free Tier Integration)
# Server-Side Only - Never expose to client/browser
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Upstash Redis Configuration (Distributed Rate Limiting & Edge Caching)
# Obtain from Upstash Console: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Cloudflare Turnstile Bot Protection
# Retrieve from Cloudflare Dashboard > Turnstile Sites
# Public Site Key (Safe to expose to client/browser):
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAxxxxxxxxxxxxxxx"
# Secret Key (Server-Side Only - NEVER expose to browser or client bundles):
TURNSTILE_SECRET_KEY="0x4AAAAAAyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# Public WhatsApp Click-to-Chat Configuration (Client-Safe)
# Destination WhatsApp phone number for direct personal chat links (digits only, e.g. 918800241462)
NEXT_PUBLIC_WHATSAPP_NUMBER="918800241462"


