# Copy to .env.test. Tests write and delete rows, so this must point at a disposable local database.
# Empty values are deliberate: they stop Prisma's automatic .env loading from filling in real credentials,
# which would let a test run send real emails, WhatsApp messages or AI requests.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/webgent_test"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/webgent_test"
AUTH_SECRET="test-only-secret-not-used-outside-the-test-suite-0123456789"
NEXTAUTH_SECRET="test-only-secret-not-used-outside-the-test-suite-0123456789"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL=error
GEMINI_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ADMIN_WHATSAPP_TO=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SLACK_WEBHOOK_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_KEY=
SUPABASE_URL=https://testproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=test-only-password
